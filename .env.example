# ========= Better Auth =========
# 会话 Cookie 签名/加密密钥，至少 32 字符高熵随机串
# 生成命令: openssl rand -base64 32
BETTER_AUTH_SECRET=

# 应用基础 URL。本地开发用 http://localhost:3000；
# 生产（Vercel）必须改为正式域名，否则 Google OAuth 回调报 redirect_uri_mismatch
BETTER_AUTH_URL=http://localhost:3000

# ========= Google OAuth =========
# 获取方式: https://console.cloud.google.com/ → APIs & Services → Credentials
#   → Create Credentials → OAuth client ID → 应用类型选 "Web application"
#   → Authorized redirect URIs 添加两条:
#     http://localhost:3000/api/auth/callback/google   (本地开发)
#     https://<你的生产域名>/api/auth/callback/google    (生产)
# 未配置时登录页自动隐藏 Google 按钮，不影响邮箱登录
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========= Supabase Postgres =========
# DATABASE_URL: 运行时连接（Vercel Serverless / Next.js 服务端用）
#   Supabase Dashboard → Connect → Transaction pooler（端口 6543，Transaction 模式）
#   格式: postgresql://postgres.<项目ref>:<数据库密码>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# DIRECT_URL: 迁移连接（drizzle-kit push/migrate 用，DDL 需 Session 模式）
#   Supabase Dashboard → Connect → Session pooler（端口 5432）
#   格式: postgresql://postgres.<项目ref>:<数据库密码>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
