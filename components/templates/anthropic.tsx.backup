import { ResumeData, ResumeHeader, WorkExperience, Education, SkillCategory, Project, Certification } from '@/types/resume'

// Anthropic风格简历模板
// 设计理念：简洁、优雅、现代，使用Anthropic品牌紫色系

interface AnthropicTemplateProps {
  data: ResumeData
}

// 简历头部组件
export function ResumeHeader({ header }: { header: ResumeHeader }) {
  return (
    <header className="mb-12 border-b border-purple-100 pb-8">
      <h1 className="text-4xl font-bold text-gray-900 mb-2 tracking-tight">
        {header.name}
      </h1>
      <h2 className="text-xl text-purple-600 font-medium mb-4">
        {header.title}
      </h2>
      <div className="flex flex-wrap gap-4 text-sm text-gray-600">
        <span className="flex items-center gap-1">
          <div className="w-2 h-2 bg-purple-300 rounded-full"></div>
          {header.email}
        </span>
        <span className="flex items-center gap-1">
          <div className="w-2 h-2 bg-purple-300 rounded-full"></div>
          {header.phone}
        </span>
        <span className="flex items-center gap-1">
          <div className="w-2 h-2 bg-purple-300 rounded-full"></div>
          {header.location}
        </span>
        {header.website && (
          <span className="flex items-center gap-1">
            <div className="w-2 h-2 bg-purple-300 rounded-full"></div>
            {header.website}
          </span>
        )}
      </div>
    </header>
  )
}

// 职业概述组件
export function ResumeSummary({ summary }: { summary: string }) {
  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        职业概述
      </h3>
      <p className="text-gray-700 leading-relaxed text-base">
        {summary}
      </p>
    </section>
  )
}

// 工作经历组件
export function ResumeExperience({ experience }: { experience: WorkExperience[] }) {
  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-6 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        工作经历
      </h3>
      <div className="space-y-8">
        {experience.map((exp) => (
          <div key={exp.id} className="relative">
            <div className="absolute left-0 top-2 w-4 h-4 bg-purple-100 rounded-full border-2 border-purple-300"></div>
            <div className="pl-8">
              <div className="flex justify-between items-start mb-2">
                <div>
                  <h4 className="text-lg font-medium text-gray-900">
                    {exp.position}
                  </h4>
                  <p className="text-purple-600 font-medium">
                    {exp.company}
                  </p>
                </div>
                <span className="text-sm text-gray-500 bg-purple-50 px-3 py-1 rounded-full">
                  {exp.startDate} - {exp.endDate}
                </span>
              </div>
              <p className="text-sm text-gray-600 mb-3">{exp.location}</p>
              <p className="text-gray-700 leading-relaxed mb-3">
                {exp.description}
              </p>
              {exp.achievements && exp.achievements.length > 0 && (
                <ul className="space-y-2">
                  {exp.achievements.map((achievement, idx) => (
                    <li key={idx} className="flex items-start">
                      <span className="text-purple-400 mr-2 mt-1">▹</span>
                      <span className="text-gray-600 text-sm">{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
              {exp.techStack && exp.techStack.length > 0 && (
                <div className="mt-4 flex flex-wrap gap-2">
                  {exp.techStack.map((tech) => (
                    <span
                      key={tech}
                      className="text-xs px-3 py-1 bg-purple-50 text-purple-700 rounded-md font-medium"
                    >
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
      <div className="mt-8 ml-8 h-px bg-purple-100"></div>
    </section>
  )
}

// 教育背景组件
export function ResumeEducation({ education }: { education: Education[] }) {
  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-6 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        教育背景
      </h3>
      <div className="space-y-6">
        {education.map((edu) => (
          <div key={edu.id} className="flex justify-between">
            <div>
              <h4 className="text-lg font-medium text-gray-900">
                {edu.school}
              </h4>
              <p className="text-purple-600">
                {edu.degree} - {edu.major}
              </p>
              {edu.gpa && (
                <p className="text-sm text-gray-600 mt-1">GPA: {edu.gpa}</p>
              )}
              {edu.honors && edu.honors.length > 0 && (
                <p className="text-sm text-gray-600 mt-1">
                  荣誉：{edu.honors.join(', ')}
                </p>
              )}
            </div>
            <span className="text-sm text-gray-500 bg-purple-50 px-3 py-1 rounded-full h-fit">
              {edu.startDate} - {edu.endDate}
            </span>
          </div>
        ))}
      </div>
    </section>
  )
}

// 技能组件
export function ResumeSkills({ skills }: { skills: SkillCategory[] }) {
  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-6 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        技能专长
      </h3>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        {skills.map((category) => (
          <div key={category.name} className="pb-6 border-b border-purple-50 last:border-b-0 last:pb-0">
            <h4 className="text-base font-medium text-purple-600 mb-3">
              {category.name}
            </h4>
            <div className="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  key={skill}
                  className="text-sm px-3 py-1.5 bg-white text-gray-700 rounded-md border border-gray-200 hover:border-purple-200 transition-colors"
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

// 项目展示组件
export function ResumeProjects({ projects }: { projects?: Project[] }) {
  if (!projects || projects.length === 0) return null

  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-6 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        项目经验
      </h3>
      <div className="grid grid-cols-1 gap-6">
        {projects.map((project) => (
          <div key={project.id} className="relative pl-8">
            <div className="absolute left-0 top-2 w-3 h-3 bg-purple-200 rounded-full"></div>
            <div className="bg-purple-50 rounded-lg p-5">
              <div className="flex justify-between items-start mb-3">
                <h4 className="text-lg font-medium text-gray-900">
                  {project.name}
                </h4>
                {project.link && (
                  <a
                    href={project.link}
                    className="text-sm text-purple-600 hover:text-purple-800 transition-colors"
                  >
                    查看项目 →
                  </a>
                )}
              </div>
              <p className="text-gray-700 leading-relaxed mb-3">
                {project.description}
              </p>
              {project.achievements && project.achievements.length > 0 && (
                <ul className="space-y-1 mb-3">
                  {project.achievements.map((achievement, idx) => (
                    <li key={idx} className="flex items-start">
                      <span className="text-purple-400 mr-2 mt-1 text-sm">▹</span>
                      <span className="text-gray-600 text-sm">{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
              <div className="flex flex-wrap gap-2">
                {project.techStack.map((tech) => (
                  <span
                    key={tech}
                    className="text-xs px-2.5 py-1 bg-white text-purple-700 rounded-md border border-purple-200 font-medium"
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

// 认证证书组件
export function ResumeCertifications({ certifications }: { certifications?: Certification[] }) {
  if (!certifications || certifications.length === 0) return null

  return (
    <section className="mb-10">
      <h3 className="text-lg font-semibold text-gray-900 mb-6 flex items-center">
        <span className="inline-block w-2 h-2 bg-purple-400 rounded-full mr-3"></span>
        认证证书
      </h3>
      <div className="space-y-4">
        {certifications.map((cert) => (
          <div key={cert.id} className="flex justify-between items-center bg-purple-50 rounded-lg p-4">
            <div>
              <h4 className="text-base font-medium text-gray-900">
                {cert.name}
              </h4>
              <p className="text-sm text-purple-600">
                {cert.issuer}
              </p>
            </div>
            <span className="text-sm text-gray-600">
              {cert.date}
            </span>
          </div>
        ))}
      </div>
    </section>
  )
}

// 主模板组件
export function AnthropicTemplate({ data }: AnthropicTemplateProps) {
  return (
    <div className="max-w-4xl mx-auto bg-white p-12 shadow-lg relative">
      <div className="absolute top-0 left-0 w-1 h-24 bg-purple-400"></div>
      <div className="absolute top-0 right-0 w-1 h-24 bg-purple-400"></div>

      <ResumeHeader header={data.header} />
      <ResumeSummary summary={data.summary} />
      <ResumeExperience experience={data.experience} />
      <ResumeEducation education={data.education} />
      <ResumeSkills skills={data.skills} />
      <ResumeProjects projects={data.projects} />
      <ResumeCertifications certifications={data.certifications} />
    </div>
  )
}

